{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cockpit-plane",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cockpit-plane",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "drizzle"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SERVER_DO",
        "class_name": "ServerDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ServerDO"]
    }
  ],
  "env": {
    "dev": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "cockpit-plane-dev",
          "database_id": "REPLACE_WITH_DEV_D1_DATABASE_ID",
          "migrations_dir": "drizzle"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "SERVER_DO",
            "class_name": "ServerDO"
          }
        ]
      }
    }
  }
}
